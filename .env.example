# ═══════════════════════════════════════════════════════════
# Notic Tahiro — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# لا ترفع .env إلى GitHub أبداً (موجود في .gitignore)
# ═══════════════════════════════════════════════════════════

# ─── Supabase ───────────────────────────────────────────────
# من: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── الذكاء الاصطناعي ────────────────────────────────────────
# ⚠️  VITE_GEMINI_API_KEY لم يَعُد مطلوباً هنا
# المفتاح يُحفظ فقط في Supabase Edge Function Secrets
# Dashboard > Edge Functions > gemini-proxy > Secrets > GEMINI_API_KEY

# ─── حماية البروكسي (اختياري لكن موصى به) ───────────────────
# سرّ مشترك يمنع الاستهلاك العشوائي لحصة Gemini عبر الرابط المباشر.
# 1) ولّد سراً عشوائياً:  openssl rand -hex 24
# 2) ضعه هنا في VITE_APP_TOKEN
# 3) وضع نفس القيمة في أسرار الدالة باسم APP_SHARED_SECRET:
#    supabase secrets set APP_SHARED_SECRET=نفس_القيمة
# إن تُرك فارغاً هنا وهناك: كل شيء يعمل كالسابق بلا فحص.
VITE_APP_TOKEN=

# ─── AdMob ──────────────────────────────────────────────────
VITE_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
